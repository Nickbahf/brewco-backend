# Neon pooled URL (PgBouncer) — used by the app at runtime
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/brewco?sslmode=require"
# Neon direct URL — used ONLY by `prisma migrate`
DIRECT_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/brewco?sslmode=require"
# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret"
PORT="3000"
